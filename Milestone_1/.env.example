# ==========================================
# MOVEIQ ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in values
# ==========================================

# ------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------
# Base URL for the frontend application (used in OAuth redirects and CORS)
FRONTEND_URL=http://localhost:3000

# ------------------------------------------
# 2. RELATIONAL DATABASE (MySQL / PostgreSQL)
# ------------------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_secure_password
DB_NAME=sports_injury_detection

# ------------------------------------------
# 3. NOSQL DATABASE (MongoDB)
# ------------------------------------------
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=moveiq_db

# ------------------------------------------
# 4. REDIS & CELERY (Queues & WebSockets)
# ------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------
# 5. ELASTICSEARCH (Search Engine)
# ------------------------------------------
# Set to 'true' for local testing, 'false' to use the cloud URL
USE_LOCAL_DB=true
LOCAL_ELASTICSEARCH_URL=http://localhost:9200
CLOUD_ELASTICSEARCH_URL=https://elasticsearch-production.up.railway.app

# ------------------------------------------
# 6. AUTHENTICATION & JWT
# ------------------------------------------
# WARNING: Generate a secure random string for production
# e.g., openssl rand -hex 32
JWT_SECRET_KEY=your_very_secret_jwt_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ------------------------------------------
# 7. THIRD PARTY APIs (Media & AI)
# ------------------------------------------
# Cloudinary (For Video Uploads and Transformations)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Groq (For LLM AI Recommendations)
GROQ_API_KEY=gsk_your_groq_api_key_here

# ------------------------------------------
# 8. EMAIL NOTIFICATIONS (SMTP)
# ------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your_app_password

# ------------------------------------------
# 9. OAUTH2 (Google Login)
# ------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback